<service>
  <id>TianshuBackendService</id>
  <name>Tianshu Cloud Base Backend</name>
  <description>天枢云基企业级核心业务主服务后台守护进程</description>
  <executable>%JAVA_HOME%\bin\java.exe</executable>
  <arguments>-Dfile.encoding=UTF-8 "-Dspring.config.additional-location=optional:file:%BASE%/.env[.properties]" -Dserver.port=8080 -jar "%BASE%\server\saas-basics-app\target\saas-basics-app-0.1.0-SNAPSHOT.jar"</arguments>
  <logmode>rotate</logmode>
  <logpath>%BASE%\logs</logpath>
  <onfailure action="restart" delay="3 sec"/>
</service>
