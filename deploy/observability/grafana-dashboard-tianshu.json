{
  "title": "Tianshu Enterprise SaaS Platform Overview",
  "uid": "tianshu-saas-overview",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "HTTP Request Rate (RPS)",
      "targets": [{ "expr": "sum(rate(http_server_requests_seconds_count[1m])) by (status)" }]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "API Latency P95 / P99 (s)",
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket[5m])) by (le))", "legendFormat": "P95" },
        { "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket[5m])) by (le))", "legendFormat": "P99" }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "JVM Heap Memory Used vs Max",
      "targets": [
        { "expr": "sum(jvm_memory_used_bytes{area=\"heap\"})", "legendFormat": "Used" },
        { "expr": "sum(jvm_memory_max_bytes{area=\"heap\"})", "legendFormat": "Max" }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "HikariCP Active vs Idle Connections",
      "targets": [
        { "expr": "hikaricp_connections_active", "legendFormat": "Active" },
        { "expr": "hikaricp_connections_idle", "legendFormat": "Idle" },
        { "expr": "hikaricp_connections_pending", "legendFormat": "Pending" }
      ]
    }
  ]
}
