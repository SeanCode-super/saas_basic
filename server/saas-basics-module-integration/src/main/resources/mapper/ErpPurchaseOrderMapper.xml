<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.saasbasics.platform.modules.erp.mapper.ErpPurchaseOrderMapper">
    <select id="lockForUpdate" resultType="com.saasbasics.platform.modules.erp.entity.ErpPurchaseOrderEntity">
        SELECT * FROM erp_purchase_order
        WHERE tenant_id = #{tenantId} AND id = #{id} AND deleted = 0
        FOR UPDATE
    </select>
</mapper>
