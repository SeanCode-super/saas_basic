<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.saasbasics.platform.modules.integration.mapper.PayOrderMapper">

    <select id="selectByOrderNoOrTradeNo" resultType="com.saasbasics.platform.modules.integration.entity.PayOrderEntity">
        SELECT *
        FROM pay_order
        WHERE (order_no = #{orderNoOrTradeNo} OR pay_trade_no = #{orderNoOrTradeNo})
          AND deleted = 0
        ORDER BY id DESC
        LIMIT 1
    </select>

</mapper>
