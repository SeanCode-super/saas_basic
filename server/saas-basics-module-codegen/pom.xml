<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.saasbasics</groupId>
        <artifactId>saas-basics-server</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>
    <artifactId>saas-basics-module-codegen</artifactId>
    <name>saas-basics-module-codegen</name>
    <dependencies>
        <dependency>
            <groupId>com.saasbasics</groupId>
            <artifactId>saas-basics-common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.saasbasics</groupId>
            <artifactId>saas-basics-framework</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.saasbasics</groupId>
            <artifactId>saas-basics-module-ai</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>
    </dependencies>
    <build>
        <resources>
            <resource><directory>src/main/resources</directory></resource>
            <!-- Ship the same supported clients the host runs, so generated sources follow both terminals. -->
            <resource>
                <directory>../../web/src</directory><targetPath>codegen/project/web</targetPath>
                <includes><include>views/industry/IndustryApplication.vue</include><include>api/modules/industry.ts</include></includes>
            </resource>
            <resource>
                <directory>../../mobile/src</directory><targetPath>codegen/project/mobile</targetPath>
                <includes><include>pages/industry/app.vue</include><include>api/industry.ts</include></includes>
            </resource>
        </resources>
    </build>
</project>
