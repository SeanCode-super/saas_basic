<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.saasbasics.platform.modules.tenant.mapper.TenantSnapshotSchemaMapper">
    <select id="storageEngine" resultType="string">
        SELECT engine FROM information_schema.tables WHERE table_schema = DATABASE() AND table_name = #{tableName}
    </select>
</mapper>
