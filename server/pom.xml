<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/>
    </parent>

    <groupId>com.saasbasics</groupId>
    <artifactId>saas-basics-server</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>saas-basics-server</name>
    <description>Enterprise SaaS foundation multi-module backend</description>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <modules>
        <module>saas-basics-app</module>
        <module>saas-basics-common</module>
        <module>saas-basics-framework</module>
        <module>saas-basics-module-dashboard</module>
        <module>saas-basics-module-tenant</module>
        <module>saas-basics-module-organization</module>
        <module>saas-basics-module-iam</module>
        <module>saas-basics-module-system</module>
        <module>saas-basics-module-integration</module>
        <module>saas-basics-module-ai</module>
        <module>saas-basics-module-file</module>
        <module>saas-basics-module-scheduler</module>
        <module>saas-basics-module-codegen</module>
        <module>saas-basics-module-audit</module>
        <module>saas-basics-module-workflow</module>
        <module>saas-basics-workflow-app</module>
    </modules>

    <properties>
        <java.version>27</java.version>
        <mybatis-plus.version>3.5.18</mybatis-plus.version>
        <springdoc.version>3.2.0</springdoc.version>
        <mysql.connector.version>9.6.0</mysql.connector.version>
        <archunit.version>1.5.1</archunit.version>
        <commons-compress.version>1.26.2</commons-compress.version>
        <flowable.version>8.0.0</flowable.version>
        <byte-buddy.version>1.18.17</byte-buddy.version>
    </properties>


    <dependencies>
        <dependency>
            <groupId>net.bytebuddy</groupId>
            <artifactId>byte-buddy-agent</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>resolve-mockito-agent</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>properties</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>-javaagent:${net.bytebuddy:byte-buddy-agent:jar}</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
