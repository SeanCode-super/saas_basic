    "@vue/runtime-dom": "^3.5.29",
    "@vue/server-renderer": "^3.5.29",
    "@vue/shared": "^3.5.29",
    "@vueuse/core": "^12.0.0",
    "axios": "^1.8.0",
    "dayjs": "^1.11.0",
    "echarts": "^5.6.0",
    "element-plus": "^2.10.0",
    "nprogress": "^0.2.0",
    "pinia": "^3.0.0",
    "vue": "^3.5.29",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
